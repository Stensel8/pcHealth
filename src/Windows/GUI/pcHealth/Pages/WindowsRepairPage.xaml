<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="pcHealth.Pages.WindowsRepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,20,28,8" Spacing="4">
            <TextBlock Text="Repair Windows"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Reinstalls Windows over itself to repair system files, keeping your files and apps."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,8,28,8" Spacing="12">

                <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
                         Title="This takes a while and ends in a restart"
                         Message="Windows downloads a repair build of the version you are running and replaces the system files with it. Reckon on half an hour to an hour. Save your work first."/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="18" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Fix problems using Windows Update"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Windows has no API for this repair, so pcHealth opens the Recovery page and presses the button for you. You get to see the exact button it found before anything happens."/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Start repair"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.StartCommand}"/>
                            <Button Content="Just open Recovery"
                                    Command="{x:Bind ViewModel.OpenRecoveryCommand}"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Width="22" Height="22" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Padding="28,12,28,20" Spacing="8">
            <Button Content="Back" Click="BackBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
